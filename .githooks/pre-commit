#!/bin/sh
# Block commits that introduce lint errors or unused imports/vars.
# Managed via: git config core.hooksPath .githooks (set by pnpm prepare).
selection_dir="$(mktemp -d "${TMPDIR:-/tmp}/markless-affected.XXXXXX")"
if [ "${MARKLESS_HOOK_ALL:-}" != "1" ]; then
	node scripts/ci/affected.mjs --staged --json >"$selection_dir/selection.json" 2>/dev/null &
	selection_pid=$!
fi

pnpm exec vp lint --deny-warnings 2>/dev/null
status=$?
if [ $status -ne 0 ]; then
	[ -n "${selection_pid:-}" ] && wait "$selection_pid" 2>/dev/null
	rm -rf "$selection_dir"
	echo ""
	echo "pre-commit: vp lint failed (unused imports/vars or lint errors)."
	echo "Fix with: pnpm exec vp lint --fix --fix-suggestions --fix-dangerously"
	exit $status
fi

# CI's fast jobs with the exact commands from ci.yml; the unit job runs the yuku-selected tests unless MARKLESS_HOOK_ALL=1.
export MARKLESS_CI_JSON_REPORT_DIR="$selection_dir"
if [ -n "${selection_pid:-}" ]; then
	wait "$selection_pid"
	node scripts/ci/local.mjs --fast --bail --unit-selection "$selection_dir/selection.json"
	status=$?
	unit_scope=selected
else
	node scripts/ci/local.mjs --fast --bail
	status=$?
	unit_scope=all
fi
unset MARKLESS_CI_JSON_REPORT_DIR

if [ -n "${selection_pid:-}" ] || node scripts/ci/affected.mjs --staged --json >"$selection_dir/selection.json" 2>/dev/null; then
	node scripts/ci/affected.mjs --shadow-log "$selection_dir/selection.json" --unit-report "$selection_dir/unit.json" --unit-scope "$unit_scope" >/dev/null 2>&1
fi
rm -rf "$selection_dir"
if [ $status -ne 0 ]; then
	echo ""
	echo "pre-commit: CI fast jobs failed (see above)."
	echo "Re-run with: pnpm ci:local --fast   (MARKLESS_HOOK_ALL=1 makes the hook run every unit test)"
	exit $status
fi

# Keep generated agent files in sync with .ruler/ sources.
if git diff --cached --name-only | grep -q '^\.ruler/'; then
	if command -v pnpm >/dev/null 2>&1 && pnpm rules >/dev/null 2>&1; then
		DRIFT="$(git diff --name-only -- AGENTS.md CLAUDE.md .claude/skills .codex/skills .mcp.json .codex/config.toml)"
		if [ -n "$DRIFT" ]; then
			echo ""
			echo "pre-commit: .ruler/ changed but generated agent files are stale."
			echo "Run: pnpm rules  and stage the regenerated files."
			exit 1
		fi
	else
		echo "pre-commit: warning: could not run 'pnpm rules' to verify agent files (offline?); skipping drift check."
	fi
fi
