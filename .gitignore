# Dependencies
node_modules/
.pnpm-store/
pnpm-store/

# Build and test output
dist/
coverage/
.output/
.output-router-preview/
.witness/
.vite/
markless-router-env.d.ts
playwright-report/
test-results/
*.tsbuildinfo

# Local/editor files
.DS_Store
*.log

# Local planning output
goals/

# Local Claude Code state (worktree copies pollute fmt/lint scans). The
# generated agent files stay tracked so the ruler drift check still sees them.
.claude/*
!.claude/settings.json
!.claude/skills/

# Vitest browser-mode failure artifacts (churn on every red run)
packages/vitest-browser/.vitest-attachments/
packages/vitest-browser/browser/__screenshots__/
packages/headless/*/.vitest-attachments/
packages/headless/*/test/__screenshots__/
.fable-codex/
.fable-opus/

# ruler apply backups
*.bak
AGENTS.md.bak
CLAUDE.md.bak
.mcp.json.bak
.codex/config.toml.bak
