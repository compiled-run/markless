# Dependencies
node_modules/
.pnpm-store/
pnpm-store/

# Build and test output
dist/
coverage/
.output/
.output-router-preview/
.witness/
.vite/
# compiled-run/markless-ecosystem-ci, fetched by scripts/ci/ecosystem-ci.mjs
.ecosystem-ci/
markless-router-env.d.ts
playwright-report/
test-results/
.vitest-attachments/
# Vitest 5 writes attachments, failure screenshots and reports under .vitest/.
.vitest/
scripts/experiments/**/results/
scripts/experiments/**/node_modules
*.tsbuildinfo

# Local/editor files
.DS_Store
*.log

# Local planning output
goals/
/output/

# Local Claude Code state (worktree copies pollute fmt/lint scans). The
# generated agent files stay tracked so the ruler drift check still sees them.
.claude/*
!.claude/settings.json
!.claude/skills/

# Vitest browser-mode failure artifacts (churn on every red run)
packages/vitest-browser/.vitest-attachments/
packages/vitest-browser/browser/__screenshots__/
packages/headless/*/.vitest-attachments/
packages/headless/*/test/__screenshots__/
.fable-codex/
.fable-opus/

# ruler apply backups
*.bak
AGENTS.md.bak
CLAUDE.md.bak
.mcp.json.bak
.codex/config.toml.bak

# goal boards are session-local working state
goals/
/output/
docs/goals/
.markless/

# raw per-sample benchmark data stays local; results keep summary, run and results files
demos/interaction-benchmark/results/**/raw.jsonl
packages/vitest-browser/browser/**/__screenshots__/

# Tool caches (Playwright browsers on CI runners and similar) are never source
.cache/
