{
	"name": "chained-async-comparison",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm run build:markless && pnpm run build:query && pnpm run build:loader",
		"build:markless": "node build-markless.mjs",
		"build:query": "vite build --config tanstack-query/vite.config.js",
		"build:loader": "vite build --config tanstack-loader/vite.config.js",
		"check": "vp check",
		"test": "node --test run.test.mjs"
	},
	"dependencies": {
		"@markless/core": "workspace:*",
		"@markless/web": "workspace:*",
		"@tanstack/react-query": "latest",
		"@tanstack/react-router": "latest",
		"@tanstack/react-start": "latest",
		"react": "latest",
		"react-dom": "latest"
	},
	"devDependencies": {
		"@vitejs/plugin-react": "latest",
		"playwright": "1.58.2",
		"vite": "8.0.16"
	},
	"packageManager": "pnpm@10.33.2"
}
