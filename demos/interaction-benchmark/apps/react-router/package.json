    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vercel/react-router": "1.3.6",
    "typescript": "^5.9.3",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
