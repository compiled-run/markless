    "solid-js": "2.0.0-rc.9"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.44",
    "filesystem-routing": "0.3.1",
    "nitro": "3.0.260903-beta",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2"
