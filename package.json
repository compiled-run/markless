{
	"name": "@arcade/arcade-workspace",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp pack",
		"check": "vp check",
		"check.format": "vp fmt --check",
		"check.lint": "vp lint",
		"fix": "vp check --fix",
		"fmt": "vp fmt",
		"format": "vp fmt",
		"lint": "vp lint --fix",
		"prepare": "vp config --hooks-only",
		"test": "vp test && pnpm --dir packages/bundler test:boxes",
		"test:compiler": "vp test packages/compiler/test/*.test.ts"
	},
	"devDependencies": {
		"@async/witness": "0.6",
		"@gruhn/regex-utils": "^2.11.0",
		"@types/node": "24.12.2",
		"magic-regexp": "^0.11.0",
		"playwright": "1.56.1",
		"rolldown": "1.0.3",
		"typescript": "5.9.3",
		"vite": "8.0.16",
		"vite-plus": "0.1.20",
		"vitest": "4.1.5"
	},
	"packageManager": "pnpm@10.33.2"
}
