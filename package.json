{
	"name": "@markless/markless-workspace",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp pack",
		"check": "vp check",
		"fmt": "vp fmt",
		"lint": "vp lint",
		"test": "vp test && pnpm bench:jsfb:guard && pnpm --dir packages/bundler test:boxes && pnpm --dir packages/router test:boxes && pnpm --dir demos/music-player test:boxes && pnpm --dir demos/music-player-ssr test:boxes",
		"bench:jsfb:compare": "node scripts/benchmarks/jsfb-baseline.mjs compare",
		"bench:jsfb:guard": "node scripts/benchmarks/jsfb-baseline.mjs compare",
		"bench:jsfb:prepare": "node scripts/benchmarks/prepare-jsfb-markless.mjs",
		"test:compiler": "vp test packages/compiler/test/*.test.ts",
		"publish": "pnpm --filter '@markless/*' --filter create-markless publish --access public --no-git-checks",
		"release": "bumpp package.json 'packages/*/package.json' && pnpm build && pnpm run publish && gh release create \"$(git describe --tags --abbrev=0)\" --generate-notes",
		"prepare": "git config core.hooksPath .githooks"
	},
	"devDependencies": {
		"@async/witness": "0.7.0",
		"create-markless": "workspace:*",
		"@markless/typescript-plugin": "workspace:*",
		"@types/node": "24.12.2",
		"bumpp": "^10.4.1",
		"rolldown": "1.0.3",
		"typescript": "5.9.3",
		"vite": "8.0.16",
		"vite-plus": "0.1.20",
		"vitest": "4.1.5"
	},
	"packageManager": "pnpm@10.33.2"
}
