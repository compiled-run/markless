{
	"name": "@markless/markless-workspace",
	"version": "0.3.3",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp pack && pnpm --filter @markless/router run build:cjs && pnpm --filter @markless/typescript-plugin run build:cjs",
		"check": "vp check",
		"typecheck": "node packages/typescript-plugin/src/tsc.ts -p tsconfig.json",
		"markless-tsc": "node packages/typescript-plugin/src/tsc.ts",
		"fmt": "vp fmt",
		"lint": "vp lint",
		"test": "pnpm --dir packages/typescript-plugin test:completion-matrix && vp test && pnpm bench:jsfb:guard && pnpm --dir packages/bundler test:boxes && pnpm --dir packages/router test:boxes && pnpm --dir demos/music-player test:boxes && pnpm --dir demos/music-player-ssr test:boxes",
		"bench:jsfb:compare": "node scripts/benchmarks/jsfb-baseline.mjs compare",
		"bench:jsfb:guard": "node scripts/benchmarks/jsfb-baseline.mjs compare",
		"bench:jsfb:prepare": "node scripts/benchmarks/prepare-jsfb-markless.mjs",
		"receipts:check": "node packages/analyzer/test-support/check-receipts.ts packages/analyzer/expected-receipts.json .",
		"receipts:generate": "vitest run --config packages/web/vitest.analyzer-debug-channel-contract.config.ts && vitest run packages/web/test/analyzer-debug-channel-contract.test.ts packages/analyzer/test/receipt-set.test.ts packages/web/test/debug-channel-registration.test.ts",
		"test:compiler": "vp test packages/compiler/test/*.test.ts",
		"test:headless": "vp test --project ui",
		"publish": "pnpm --filter '@markless/*' --filter create-markless publish --access public --no-git-checks",
		"release": "bumpp package.json --no-commit --no-tag --no-push && node scripts/release/sync-version.mjs",
		"release:check": "node scripts/release/sync-version.mjs --check",
		"release:notes": "node scripts/release/release-notes.mjs",
		"release:trust": "sh scripts/release/trust-publishers.sh",
		"state": "node scripts/state-ledger.mjs",
		"rules": "npx -y @intellectronica/ruler apply",
		"prepare": "git config core.hooksPath .githooks"
	},
	"devDependencies": {
		"@async/witness": "0.7.0",
		"@markless/typescript-plugin": "workspace:*",
		"@types/node": "24.12.2",
		"bumpp": "^10.4.1",
		"changelogen": "^0.6.2",
		"create-markless": "workspace:*",
		"rolldown": "1.0.3",
		"typescript": "5.9.3",
		"vite": "8.0.16",
		"vite-plus": "0.1.20",
		"vitest": "4.1.5"
	},
	"packageManager": "pnpm@10.33.2"
}
