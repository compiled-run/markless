{
	"name": "@markless/analyzer",
	"version": "0.3.0",
	"description": "Portable browser QA analysis contracts with an optional Playwright driver.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/markless-dev/markless.git",
		"directory": "packages/analyzer"
	},
	"files": [
		"dist",
		"route-action-matrix.schema.json",
		"verdict-report.schema.json"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./playwright": "./src/playwright.ts"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./playwright": {
				"types": "./dist/playwright.d.ts",
				"default": "./dist/playwright.js"
			}
		}
	},
	"scripts": {
		"prepublishOnly": "node ../../scripts/release/verify-publish-ready.mjs"
	},
	"dependencies": {
		"ufo": "catalog:"
	},
	"devDependencies": {
		"playwright": "1.58.2"
	},
	"peerDependencies": {
		"playwright": ">=1.58.0"
	},
	"peerDependenciesMeta": {
		"playwright": {
			"optional": true
		}
	}
}
