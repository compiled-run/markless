{
	"name": "@markless/bundler",
	"version": "0.1.1",
	"description": "Markless build plugins for Rolldown and Vite.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/markless-dev/markless.git",
		"directory": "packages/bundler"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			"./preload": {
				"types": "./dist/preload.d.ts",
				"default": "./dist/preload.js"
			},
			"./rolldown": {
				"types": "./dist/rolldown.d.ts",
				"default": "./dist/rolldown.js"
			},
			"./vite": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			}
		}
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./preload": "./src/preload.ts",
		"./rolldown": "./src/rolldown.ts",
		"./vite": "./src/vite/index.ts"
	},
	"scripts": {
		"test:boxes": "witness run",
		"prepublishOnly": "node ../../scripts/release/verify-publish-ready.mjs"
	},
	"dependencies": {
		"@markless/compiler": "workspace:*",
		"@markless/web": "workspace:*",
		"@thi.ng/dgraph": "catalog:",
		"pathe": "catalog:",
		"ufo": "catalog:"
	},
	"peerDependencies": {
		"rolldown": "1.0.3",
		"vite": "8.0.16"
	},
	"peerDependenciesMeta": {
		"rolldown": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"files": [
		"dist"
	]
}