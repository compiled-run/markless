{
	"name": "create-markless",
	"version": "0.2.1",
	"description": "Create Markless apps.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/markless-dev/markless.git",
		"directory": "packages/cli"
	},
	"bin": {
		"create-markless": "./src/node.ts"
	},
	"files": [
		"dist",
		"templates"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"access": "public",
		"bin": {
			"create-markless": "./dist/node.js"
		},
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"provenance": true
	},
	"scripts": {
		"prepublishOnly": "node ../../scripts/release/verify-publish-ready.mjs"
	},
	"dependencies": {
		"@clack/prompts": "^1.6.0",
		"am-i-vibing": "^0.5.0",
		"jsonc-parser": "^3.3.1",
		"pathe": "catalog:",
		"picomatch": "^4.0.4",
		"ufo": "catalog:",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@types/picomatch": "^4.0.2"
	}
}
