{
	"name": "@markless/compiler",
	"version": "0.2.0",
	"description": "Markless TSRX compiler: semantic graph, state lowering, payload planning, emit.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/markless-dev/markless.git",
		"directory": "packages/compiler"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./type-service": {
				"types": "./dist/type-service.d.ts",
				"default": "./dist/type-service.js"
			}
		}
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./type-service": "./src/type-service.ts"
	},
	"dependencies": {
		"@markless/serializer": "workspace:*",
		"@tsrx/core": "catalog:"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"prepublishOnly": "node ../../scripts/release/verify-publish-ready.mjs"
	}
}
