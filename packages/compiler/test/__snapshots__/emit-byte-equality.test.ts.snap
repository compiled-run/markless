	const marklessSsrRendered=await renderSsrData({renderData:{...marklessRenderData,root:{componentName:"App",templateId:"template:App"}},idPrefix:marklessSsrIdPrefix,read:marklessSsrReadData,selectBranchArm:(marklessSsrDataSlot,marklessSsrDataContext)=>{const entry=marklessSsrDataContext.repeatItem;const error=marklessSsrDataContext.asyncError;switch(marklessSsrDataSlot.branchSiteId){default:throw new Error('MARKLESS_SSR_DATA_BRANCH_MISSING: '+marklessSsrDataSlot.branchSiteId);}},selectAsyncArm:async(marklessSsrDataSlot,marklessSsrDataContext)=>{const entry=marklessSsrDataContext.repeatItem;const error=marklessSsrDataContext.asyncError;switch(marklessSsrDataSlot.boundaryId){default:throw new Error('MARKLESS_SSR_DATA_BOUNDARY_MISSING: '+marklessSsrDataSlot.boundaryId);}},renderChild:async(marklessSsrDataSlot,marklessSsrDataContext)=>{const entry=marklessSsrDataContext.repeatItem;const error=marklessSsrDataContext.asyncError;switch(marklessSsrDataSlot.componentEdgeId){default:throw new Error('MARKLESS_SSR_DATA_CHILD_MISSING: '+marklessSsrDataSlot.componentEdgeId);}}});
