{
	"name": "@markless/ui",
	"version": "0.4.0",
	"description": "Headless, accessible UI components for Markless.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/compiled-run/markless.git",
		"directory": "packages/headless/components"
	},
	"files": [
		"api",
		"src",
		"!src/**/*.browser.ts",
		"!src/**/*.sr.ts",
		"!src/**/*.nvda.ts",
		"!src/**/*.voiceover.ts",
		"!src/**/*-transcript.ts",
		"!src/**/note.md",
		"!src/**/scenarios"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./api/manifest.json": "./api/manifest.json",
		"./accordion": "./src/accordion/index.ts",
		"./calendar": "./src/calendar/index.ts",
		"./carousel": "./src/carousel/index.ts",
		"./checkbox": "./src/checkbox/index.ts",
		"./checklist": "./src/checklist/index.ts",
		"./collapsible": "./src/collapsible/index.ts",
		"./colorpicker": "./src/colorpicker/index.ts",
		"./combobox": "./src/combobox/index.ts",
		"./datebox": "./src/datebox/index.ts",
		"./fileupload": "./src/fileupload/index.ts",
		"./ink": "./src/ink/index.ts",
		"./menu": "./src/menu/index.ts",
		"./modal": "./src/modal/index.ts",
		"./otp": "./src/otp/index.ts",
		"./pad": "./src/pad/index.ts",
		"./navbar": "./src/navbar/index.ts",
		"./numberbox": "./src/numberbox/index.ts",
		"./pagination": "./src/pagination/index.ts",
		"./popover": "./src/popover/index.ts",
		"./progress": "./src/progress/index.ts",
		"./qrcode": "./src/qr-code/index.ts",
		"./radiogroup": "./src/radio-group/index.ts",
		"./select": "./src/select/index.ts",
		"./slider": "./src/slider/index.ts",
		"./tooltip": "./src/tooltip/index.ts",
		"./tabs": "./src/tabs/index.ts",
		"./textbox": "./src/textbox/index.ts",
		"./toaster": "./src/toaster/index.ts",
		"./toggle": "./src/toggle/index.ts",
		"./togglegroup": "./src/togglegroup/index.ts",
		"./tour": "./src/tour/index.ts",
		"./tree": "./src/tree/index.ts"
	},
	"publishConfig": {
		"access": "public",
		"marklessShipsSource": true,
		"provenance": true
	},
	"scripts": {
		"api:extract": "node api-extract/write.ts",
		"api:check": "vp test run --config api-extract/vitest.config.ts"
	},
	"dependencies": {
		"@markless/core": "workspace:*"
	},
	"devDependencies": {
		"@markless/vitest-browser": "workspace:*",
		"axe-core": "4.13.0",
		"playwright": "1.58.2",
		"yuku-analyzer": "0.9.1"
	},
	"peerDependencies": {
		"vite": "^8.0.16",
		"vitest": "^4.1.5"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	}
}
