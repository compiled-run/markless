{
	"name": "@markless/ui-tools",
	"version": "0.4.0",
	"description": "Build tools for the Markless UI design system.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/compiled-run/markless.git",
		"directory": "packages/headless/tools"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/vite.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			}
		},
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"prepublishOnly": "node ../../../scripts/release/verify-publish-ready.mjs"
	},
	"dependencies": {
		"@markless/icons": "workspace:*"
	},
	"peerDependencies": {
		"vite": "^8.0.16"
	}
}
