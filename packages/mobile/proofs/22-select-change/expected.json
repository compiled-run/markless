			"absent": ["Make none", "Changes 0"]
		},
		{
			"do": {
				"choose": {
					"field": "Make",
					"option": "BMW"
				}
			},
			"visible": ["BMW", "Make bmw", "Changes 2"],
			"absent": ["Make toyota", "Changes 1", "Size LARGE"]
		},
		{
			"do": {
				"choose": {
					"field": "Size",
					"option": "large"
				}
			},
			"visible": ["large", "Size LARGE", "Changes 2"],
			"absent": ["Size none"]
