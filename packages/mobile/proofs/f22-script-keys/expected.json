{
	"rung": 203,
	"name": "A text field's keydown handler that only JavaScript can run, with a loop and a cancelled return key, as on the web",
	"steps": [
		{ "visible": ["Tags", "Tags: red", "Nothing added"] },
		{
			"do": { "type": { "field": "Tag", "text": "blue" } },
			"visible": ["Tags: red", "Nothing added"],
			"fields": { "Tag": "blue" }
		},
		{
			"do": { "submit": "Tag" },
			"visible": ["Tags: red, blue", "Added blue"],
			"absent": ["Tags: red", "Nothing added"],
			"fields": { "Tag": "" }
		},
		{
			"do": { "type": { "field": "Tag", "text": "red" } },
			"visible": ["Tags: red, blue", "Added blue"],
			"fields": { "Tag": "red" }
		},
		{
			"do": { "submit": "Tag" },
			"visible": ["Tags: red, blue", "Already have red"],
			"absent": ["Added blue"],
			"fields": { "Tag": "red" }
		}
	]
}
