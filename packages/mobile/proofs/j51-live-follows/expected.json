		},
		{
			"do": { "tap": "Next" },
			"visible": ["Slide 3", "Upload saved"],
			"absent": ["Slide 2", "Upload failed"]
		},
		{ "do": { "tap": "Fail" }, "visible": ["Upload failed"], "absent": ["Upload saved"] }
	]
}
