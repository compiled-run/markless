		{
			"do": { "tap": "Toggle door" },
			"visible": ["Door open", "Quiet note"],
			"absent": ["Door shut"]
		},
		{
			"do": { "tap": "Toggle loud" },
			"visible": ["Loud note", "Door open"],
			"absent": ["Quiet note"]
		}
	]
