export default function Generics() @{
	<main class="generics">
		<style>
			.generics {
				padding: 24px;
			}
			.title {
				font-family: system-ui;
				font-size: 28px;
				font-weight: 700;
			}
			.subtitle {
				font-family: system-ui;
				font-size: 20px;
				font-weight: 400;
			}
			.sans {
				font-family: sans-serif;
				font-size: 17px;
			}
			.serif {
				font-family: serif;
				font-size: 17px;
			}
			.serif-bold {
				font-family: serif;
				font-size: 17px;
				font-weight: 700;
			}
			.mono {
				font-family: monospace;
				font-size: 15px;
			}
		</style>
		<title>Generics</title>
		<h1 class="title">Harbour tides</h1>
		<h2 class="subtitle">Drawn in the phone's own font</h2>
		<p class="sans">Sans-serif: waffles, quays and fjords along the harbour wall</p>
		<p class="serif">Serif: the quick brown fox jumps over the lazy dog</p>
		<p class="serif-bold">Bold serif: AVATAR Type office</p>
		<p class="mono">Monospace: tide table 0412</p>
	</main>
}
