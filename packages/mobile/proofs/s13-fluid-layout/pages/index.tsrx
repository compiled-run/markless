export default function Field() @{
	<main class="page">
		<title>Field notes</title>
		<div class="hero">
			<h1>Field notes</h1>
		</div>
		<div class="row">
			<p class="cell">Left half</p>
			<p class="cell">Right half</p>
		</div>
		<div class="bar"></div>
		<div class="chips">
			<span class="chip">Basil</span>
			<span class="chip">Thyme</span>
			<span class="chip">Sorrel</span>
			<span class="chip">Lovage</span>
			<span class="chip">Chervil</span>
		</div>
		<p class="story">The north bed took the frost hardest this week, so the basil moved under glass while the thyme and the sorrel stayed out and came through without a mark on them.</p>
	</main>
}
