{
	"rung": "S53",
	"name": "On styled pages, a note's title typed into a text field is saved and shows in the list, as the web does",
	"steps": [
		{
			"visible": ["All notes", "Write a note"]
		},
		{
			"do": {
				"tap": "Write a note"
			},
			"visible": ["Title", "Save note"],
			"absent": ["All notes"]
		},
		{
			"do": {
				"type": {
					"field": "Title",
					"text": "Groceries"
				}
			},
			"visible": ["Save note"],
			"fields": {
				"Title": "Groceries"
			}
		},
		{
			"do": {
				"tap": "Save note"
			},
			"visible": ["All notes", "Groceries", "Write a note"],
			"absent": ["Save note"],
			"order": ["All notes", "Groceries", "Write a note"]
		}
	]
}
