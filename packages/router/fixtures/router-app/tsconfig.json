{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"types": ["vite/client"],
		"plugins": [
			{
				"name": "@markless/typescript-plugin"
			},
			{
				"name": "@markless/router/typescript-plugin"
			}
		]
	},
	"include": ["markless-router-env.d.ts", "document.tsrx", "pages", "vite.config.ts"]
}
