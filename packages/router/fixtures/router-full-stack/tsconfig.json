{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"types": ["vite/client"],
		"plugins": [
			{
				"name": "@arcade/typescript-plugin"
			},
			{
				"name": "@arcade/router/typescript-plugin"
			}
		]
	},
	"include": [
		"api",
		"arcade-router-env.d.ts",
		"document.tsrx",
		"middleware",
		"pages",
		"vite.config.ts"
	]
}
