{
	"name": "@markless/router",
	"version": "0.1.2-dev.0",
	"description": "Markless router: client-side navigation with SSR streaming and build-time preload maps.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/markless-dev/markless.git",
		"directory": "packages/router"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./vite": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			},
			"./vite/runtime/create-route-discovery": {
				"types": "./dist/vite/runtime/create-route-discovery.d.ts",
				"default": "./dist/vite/runtime/create-route-discovery.js"
			},
			"./vite/runtime/mdx-route": {
				"types": "./dist/vite/runtime/mdx-route.d.ts",
				"default": "./dist/vite/runtime/mdx-route.js"
			},
			"./vite/runtime/create-server-entry": {
				"types": "./dist/vite/runtime/create-server-entry.d.ts",
				"default": "./dist/vite/runtime/create-server-entry.js"
			},
			"./vite/route-href": {
				"types": "./dist/vite/route-href.d.ts",
				"default": "./dist/vite/route-href.js"
			},
			"./typescript-plugin": {
				"types": "./dist/typescript-plugin.d.ts",
				"default": "./dist/typescript-plugin.js"
			}
		}
	},
	"files": [
		"dist",
		"src/vite/entries"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./vite": "./src/vite/index.ts",
		"./vite/runtime/create-route-discovery": "./src/vite/runtime/create-route-discovery.ts",
		"./vite/runtime/mdx-route": "./src/vite/runtime/mdx-route.ts",
		"./vite/runtime/create-server-entry": "./src/vite/runtime/create-server-entry.ts",
		"./vite/route-href": "./src/vite/entries/route-href.ts",
		"./typescript-plugin": "./src/typescript-plugin/index.ts"
	},
	"scripts": {
		"test:boxes": "witness run",
		"prepublishOnly": "node ../../scripts/release/verify-publish-ready.mjs"
	},
	"dependencies": {
		"@markless/bundler": "workspace:*",
		"@markless/web": "workspace:*",
		"@tsrx/core": "catalog:",
		"@virtualstate/navigation": "1.0.1-alpha.212",
		"hast-util-to-html": "catalog:",
		"nitro": "catalog:",
		"pathe": "catalog:",
		"satteri": "catalog:",
		"ufo": "catalog:"
	},
	"peerDependencies": {
		"vite": "8.0.16"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	}
}