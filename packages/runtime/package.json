{
	"name": "@markless/runtime",
	"version": "0.3.2",
	"description": "Markless state graph runtime: reads, writes, computed invalidation, flush journal.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/compiled-run/markless.git",
		"directory": "packages/runtime"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./graph": {
				"types": "./dist/graph.d.ts",
				"default": "./dist/graph.js"
			},
			"./graph-reconcile": {
				"types": "./dist/graph-reconcile.d.ts",
				"default": "./dist/graph-reconcile.js"
			}
		}
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./graph": "./src/graph.ts",
		"./graph-reconcile": "./src/graph-reconcile.ts"
	},
	"dependencies": {
		"@markless/serializer": "workspace:*"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"prepublishOnly": "node ../../scripts/release/verify-publish-ready.mjs"
	}
}
