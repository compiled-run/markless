{
	"name": "@markless/serializer",
	"version": "0.3.3",
	"description": "Markless serialization tiers and resumability payload protocol.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/compiled-run/markless.git",
		"directory": "packages/serializer"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./async-boundary-arm": "./src/async-boundary-arm.ts",
		"./decode": "./src/value-decode.ts",
		"./resume-record-delta": "./src/resume-record-delta.ts",
		"./resume-record-merge": "./src/resume-record-merge.ts",
		"./decode-client": "./src/value-decode-client.ts",
		"./protocol": "./src/protocol.ts",
		"./protocol-validation": "./src/protocol-validation-storage.ts"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./async-boundary-arm": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./decode": {
				"types": "./dist/decode.d.ts",
				"default": "./dist/decode.js"
			},
			"./resume-record-delta": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./resume-record-merge": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./decode-client": {
				"types": "./dist/decode-client.d.ts",
				"default": "./dist/decode-client.js"
			},
			"./protocol": {
				"types": "./dist/protocol.d.ts",
				"default": "./dist/protocol.js"
			},
			"./protocol-validation": {
				"types": "./dist/protocol-validation.d.ts",
				"default": "./dist/protocol-validation.js"
			}
		},
		"provenance": true
	},
	"scripts": {
		"prepublishOnly": "node ../../scripts/release/verify-publish-ready.mjs"
	}
}
