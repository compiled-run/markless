{
	"name": "@markless/typescript-plugin",
	"version": "0.3.1",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/compiled-run/markless.git",
		"directory": "packages/typescript-plugin"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"exports": {
		".": {
			"import": "./src/index.ts",
			"require": "./dist/index.cjs"
		},
		"./language": "./src/language.ts",
		"./volar": {
			"import": "./src/volar.ts",
			"require": "./dist/volar.cjs"
		},
		"./jsx-runtime": {
			"types": "./src/markless-jsx.d.ts"
		},
		"./jsx-dev-runtime": {
			"types": "./src/markless-jsx.d.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"exports": {
			".": {
				"types": "./dist/index.d.cts",
				"require": "./dist/index.cjs",
				"default": "./dist/index.cjs"
			},
			"./language": {
				"types": "./dist/language.d.cts",
				"require": "./dist/language.cjs",
				"default": "./dist/language.cjs"
			},
			"./volar": {
				"types": "./dist/volar.d.cts",
				"require": "./dist/volar.cjs",
				"default": "./dist/volar.cjs"
			},
			"./jsx-runtime": {
				"types": "./dist/markless-jsx.d.ts"
			},
			"./jsx-dev-runtime": {
				"types": "./dist/markless-jsx.d.ts"
			}
		}
	},
	"scripts": {
		"build:cjs": "vp pack src/index.ts --no-config --format cjs --platform node --out-dir dist --clean --dts --no-report && vp pack src/language.ts src/volar.ts --no-config --format cjs --platform node --out-dir dist --no-clean --dts --no-report && cp src/markless-jsx.d.ts dist/markless-jsx.d.ts",
		"prepublishOnly": "pnpm run build:cjs && node ../../scripts/release/verify-publish-ready.mjs",
		"test:completion-matrix": "MARKLESS_COMPLETION_MATRIX_STARTED_AT=$(node -p 'Date.now()') pnpm run test:completion-matrix:run",
		"test:completion-matrix:run": "pnpm run build:cjs && pnpm --dir ../router run build:cjs && pnpm -w exec vitest run --config packages/typescript-plugin/vitest.completion-matrix.config.ts"
	},
	"dependencies": {
		"@markless/compiler": "workspace:*",
		"@markless/router": "workspace:*",
		"@tsrx/typescript-plugin": "0.3.112",
		"csstype": "catalog:"
	},
	"peerDependencies": {
		"typescript": "catalog:"
	}
}
