{
	"contentMappers": [
		{
			"package": "@tsrx/content-mapper",
			"extensions": [".tsrx"],
			"options": { "compiler": "@markless/typescript-plugin/volar-strict" }
		}
	],
	"tsrx": {
		"compiler": "@markless/typescript-plugin/volar"
	},
	"compilerOptions": {
		"jsx": "preserve",
		"lib": ["ES2022", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": []
	}
}
