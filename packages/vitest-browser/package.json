{
	"name": "@markless/vitest-browser",
	"version": "0.3.2",
	"description": "Vitest browser-mode provider for Markless components.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/compiled-run/markless.git",
		"directory": "packages/vitest-browser"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./ssr-plugin": "./src/ssr-plugin.ts",
		"./vitest": "./src/vitest.ts"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./ssr-plugin": {
				"types": "./dist/ssr-plugin.d.ts",
				"default": "./dist/ssr-plugin.js"
			},
			"./vitest": {
				"types": "./dist/vitest.d.ts",
				"default": "./dist/vitest.js"
			}
		},
		"provenance": true
	},
	"scripts": {
		"prepublishOnly": "node ../../scripts/release/verify-publish-ready.mjs"
	},
	"dependencies": {
		"@markless/core": "workspace:*",
		"@markless/web": "workspace:*",
		"pathe": "catalog:"
	},
	"devDependencies": {
		"playwright": "1.58.2"
	},
	"peerDependencies": {
		"vite": "^8.0.16",
		"vitest": "^4.1.5"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"//": "Published. The first publish had to be done by hand at 0.1.1 because npm cannot attach a trusted publisher to a name that has never existed, and a laptop publish cannot carry provenance. From here it releases through CI with the other packages and gets provenance like everything else."
}
