{
	"name": "@markless/web",
	"version": "0.1.1",
	"description": "Markless unified render/resume runtime for the web.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/markless-dev/markless.git",
		"directory": "packages/web"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./dom-journal": "./src/dom-journal.ts",
		"./dom-update": "./src/dom-update.ts",
		"./event-only-resume": "./src/event-only-resume.ts",
		"./event-only-lean/row": "./src/event-only-lean/row.ts",
		"./event-only-lean/scalar-core": "./src/event-only-lean/scalar-core.ts",
		"./event-only-lean/scalar-resume": "./src/event-only-lean/scalar-resume.ts",
		"./event-resume": "./src/event-resume.ts",
		"./inline/resumer": "./src/inline/resumer.ts",
		"./fns/*": "./src/fns/*.ts",
		"./payload": "./src/payload.ts",
		"./render": "./src/render.ts",
		"./render-to-stream": "./src/render-to-stream.ts",
		"./render-to-string": "./src/render-to-string.ts",
		"./resume": "./src/payload-full.ts"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./dom-journal": {
				"types": "./dist/dom-journal.d.ts",
				"default": "./dist/dom-journal.js"
			},
			"./dom-update": {
				"types": "./dist/dom-update.d.ts",
				"default": "./dist/dom-update.js"
			},
			"./event-only-resume": {
				"types": "./dist/event-only-resume.d.ts",
				"default": "./dist/event-only-resume.js"
			},
			"./event-only-lean/row": {
				"types": "./dist/event-only-lean/row.d.ts",
				"default": "./dist/event-only-lean/row.js"
			},
			"./event-only-lean/scalar-core": {
				"types": "./dist/event-only-lean/scalar-core.d.ts",
				"default": "./dist/event-only-lean/scalar-core.js"
			},
			"./event-only-lean/scalar-resume": {
				"types": "./dist/event-only-lean/scalar-resume.d.ts",
				"default": "./dist/event-only-lean/scalar-resume.js"
			},
			"./event-resume": {
				"types": "./dist/event-resume.d.ts",
				"default": "./dist/event-resume.js"
			},
			"./inline/resumer": {
				"types": "./dist/inline/resumer.d.ts",
				"default": "./dist/inline/resumer.js"
			},
			"./fns/*": {
				"types": "./dist/fns/*.d.ts",
				"default": "./dist/fns/*.js"
			},
			"./payload": {
				"types": "./dist/payload.d.ts",
				"default": "./dist/payload.js"
			},
			"./render": {
				"types": "./dist/render.d.ts",
				"default": "./dist/render.js"
			},
			"./render-to-stream": {
				"types": "./dist/render-to-stream.d.ts",
				"default": "./dist/render-to-stream.js"
			},
			"./render-to-string": {
				"types": "./dist/render-to-string.d.ts",
				"default": "./dist/render-to-string.js"
			},
			"./resume": {
				"types": "./dist/resume.d.ts",
				"default": "./dist/resume.js"
			}
		}
	},
	"scripts": {
		"prepublishOnly": "node ../../scripts/release/verify-publish-ready.mjs"
	},
	"dependencies": {
		"@markless/runtime": "workspace:*",
		"@markless/serializer": "workspace:*"
	},
	"devDependencies": {
		"@markless/analyzer": "workspace:*"
	}
}
