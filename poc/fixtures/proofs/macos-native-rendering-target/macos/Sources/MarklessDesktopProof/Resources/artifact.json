{
	"schema": "markless-native-rendering-proof/v0",
	"source": "src/App.tsrx",
	"targetProfile": "portable-host",
	"nativeTarget": "macos-appkit",
	"graph": {
		"cells": [
			{
				"id": "state:count",
				"initial": 0,
				"type": "number"
			}
		]
	},
	"host": {
		"nodes": [
			{
				"id": "host:root",
				"type": "main"
			},
			{
				"id": "host:title",
				"type": "h1",
				"parent": "host:root",
				"staticText": "Markless macOS Proof"
			},
			{
				"id": "host:button",
				"type": "button",
				"parent": "host:root"
			},
			{
				"id": "host:buttonText",
				"type": "text",
				"parent": "host:button"
			}
		],
		"events": [
			{
				"node": "host:button",
				"authoredEvent": "onClick",
				"semanticEvent": "activate",
				"nativeEvent": "action",
				"symbolId": "symbol:counter.increment"
			}
		],
		"textBindings": [
			{
				"node": "host:buttonText",
				"sourceCell": "state:count",
				"template": "Count ${value}"
			}
		]
	},
	"symbols": {
		"symbol:counter.increment": {
			"kind": "event-handler",
			"body": "graph[\"state:count\"] = graph[\"state:count\"] + 1;"
		}
	}
}
