+export const PACKED_MODULE_REGISTRY_KEY = '__markless_modules__';
+
+export function packedSymbolKey(scope: string, id: string): string {
+	return JSON.stringify([scope, id]);
+}
+
+export type PackedModuleExports = Record<string, unknown>;
+export type PackedModuleFactory = (
+	module: { exports: PackedModuleExports },
+	exports: PackedModuleExports,
+	require: (id: string) => PackedModuleExports,
+) => void;
+export type PackedSymbolRoute = readonly [moduleId: string, exportName: string];
+export type PackedModuleRegistry = {
+	register(
+		factories: Record<string, PackedModuleFactory>,
+		symbols: Record<string, PackedSymbolRoute>,
+	): void;
+	load(id: string): PackedModuleExports;
+	symbol(id: string, scope?: string): unknown;
+};
