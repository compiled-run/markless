+import { runInNewContext } from 'node:vm';
+import { describe, expect, test } from 'vitest';
+import {
+	PACKED_MODULE_REGISTRY_KEY,
+	packedSymbolKey,
+	type PackedModuleRegistry,
+} from '@markless/serializer/protocol';
+import { emitPackedModules } from '../src/build/packed-modules.ts';
+
+describe('packed module delivery', () => {
+	test('keeps identical local symbol IDs from separate source modules distinct', async () => {
+		const output = await emitPackedModules({
+			modules: new Map([
+				['/build/first.js', 'export const value = 1;'],
+				['/build/second.js', 'export const value = 2;'],
+			]),
+			packs: new Map([['route', ['/build/first.js', '/build/second.js']]]),
+			symbols: {
+				[packedSymbolKey('first', 'symbol:0')]: ['/build/first.js', 'value'],
+				[packedSymbolKey('second', 'symbol:0')]: ['/build/second.js', 'value'],
+			},
+		});
+		const context = {};
+		runInNewContext(output.packs.get('route')!, context);
+		expect(packedRegistry(context).symbol('symbol:0', 'first')).toBe(1);
+		expect(packedRegistry(context).symbol('symbol:0', 'second')).toBe(2);
+	});
+
+	for (const name of ['counter', 'inventory']) {
+		test(`${name}: registration is lazy and shared live bindings survive separate packs`, async () => {
+			const runtime = '/build/shared.js';
+			const first = `/build/${name}-first.js`;
+			const second = `/build/${name}-second.js`;
+			const output = await emitPackedModules({
+				modules: new Map([
+					[
+						runtime,
+						'globalThis.runs.push("shared"); export let value = 0; export function increment() { value++; }',
+					],
+					[
+						first,
+						'import { value, increment } from "./shared.js"; globalThis.runs.push("first"); export function activate() { increment(); return value; }',
+					],
+					[
+						second,
+						'import { value } from "./shared.js"; globalThis.runs.push("second"); export function read() { return value; }',
+					],
+				]),
+				packs: new Map([
+					['runtime', [runtime]],
+					['route', [first, second]],
+				]),
+				symbols: { click: [first, 'activate'], read: [second, 'read'] },
+			});
+			const context = { runs: [] as string[] };
+			runInNewContext(output.packs.get('runtime')!, context);
+			runInNewContext(output.packs.get('route')!, context);
+			expect(context.runs).toEqual([]);
+			const registry = packedRegistry(context);
+			expect((registry.symbol('click') as () => number)()).toBe(1);
+			expect(context.runs).toEqual(['shared', 'first']);
+			expect((registry.symbol('read') as () => number)()).toBe(1);
+			expect((registry.symbol('click') as () => number)()).toBe(2);
+			expect((registry.symbol('read') as () => number)()).toBe(2);
+			expect(context.runs).toEqual(['shared', 'first', 'second']);
+			runInNewContext(output.packs.get('route')!, context);
+			expect((registry.symbol('read') as () => number)()).toBe(2);
+		});
+	}
+
+	test('lowered dynamic imports initialize locally and need no host module loader', async () => {
+		const output = await emitPackedModules({
+			modules: new Map([
+				[
+					'/build/root.js',
+					'export const activate = async () => (await import("./lazy.js")).value;',
+				],
+				['/build/lazy.js', 'globalThis.runs.push("lazy"); export const value = 42;'],
+			]),
+			packs: new Map([['route', ['/build/root.js', '/build/lazy.js']]]),
+			symbols: { click: ['/build/root.js', 'activate'] },
+		});
+		const context = { runs: [] as string[] };
+		runInNewContext(output.packs.get('route')!, context);
+		expect(context.runs).toEqual([]);
+		expect(await (packedRegistry(context).symbol('click') as () => Promise<number>)()).toBe(42);
+		expect(context.runs).toEqual(['lazy']);
+	});
+
+	test('fails the build for an unknown static dependency', async () => {
+		await expect(
+			emitPackedModules({
+				modules: new Map([['/build/root.js', 'export { value } from "./missing.js";']]),
+				packs: new Map([['route', ['/build/root.js']]]),
+				symbols: {},
+			}),
+		).rejects.toThrow(/root\.js.*missing\.js/);
+	});
+
+	test('supports namespace exports, default exports, re-exports, and circular functions', async () => {
+		const modules = new Map([
+			[
+				'/build/a.js',
+				'import { b } from "./b.js"; export function a() { return b(); } export default 5;',
+			],
+			['/build/b.js', 'import { a } from "./a.js"; export function b() { return typeof a; }'],
+			[
+				'/build/barrel.js',
+				'export * as namespace from "./a.js"; export { default } from "./a.js";',
+			],
+			['/build/other.js', 'export * as namespace from "./b.js";'],
+		]);
+		const output = await emitPackedModules({
+			modules,
+			packs: new Map([['route', [...modules.keys()]]]),
+			symbols: {
+				click: ['/build/barrel.js', 'namespace'],
+				default: ['/build/barrel.js', 'default'],
+			},
+		});
+		const context = {};
+		runInNewContext(output.packs.get('route')!, context);
+		expect(packedRegistry(context).symbol('default')).toBe(5);
+		const namespace = packedRegistry(context).symbol('click') as { a(): string };
+		expect(namespace.a()).toBe('function');
+	});
+
+	test('initialization failures remain failures and do not return partial modules later', async () => {
+		const output = await emitPackedModules({
+			modules: new Map([
+				[
+					'/build/broken.js',
+					'globalThis.runs.push("broken"); throw new Error("initialization failed"); export const value = 1;',
+				],
+			]),
+			packs: new Map([['route', ['/build/broken.js']]]),
+			symbols: { click: ['/build/broken.js', 'value'] },
+		});
+		const context = { runs: [] as string[] };
+		runInNewContext(output.packs.get('route')!, context);
+		for (let attempt = 0; attempt < 2; attempt++) {
+			expect(() => packedRegistry(context).symbol('click')).toThrow('initialization failed');
+		}
+		expect(context.runs).toEqual(['broken']);
+	});
+
+	test('fails the build for a computed import instead of retaining a network fallback', async () => {
+		await expect(
+			emitPackedModules({
+				modules: new Map([
+					['/build/root.js', 'export const activate = (path) => import(path);'],
+				]),
+				packs: new Map([['route', ['/build/root.js']]]),
+				symbols: {},
+			}),
+		).rejects.toThrow(/root\.js.*statically resolved/);
+	});
+
+	test('fails the build for a symbol with a missing export', async () => {
+		await expect(
+			emitPackedModules({
+				modules: new Map([['/build/root.js', 'export const value = 1;']]),
+				packs: new Map([['route', ['/build/root.js']]]),
+				symbols: { click: ['/build/root.js', 'absent'] },
+			}),
+		).rejects.toThrow(/click.*absent/);
+	});
+
+	test('fails the build for a symbol whose module was left out of delivery', async () => {
+		await expect(
+			emitPackedModules({
+				modules: new Map([['/build/root.js', 'export const value = 1;']]),
+				packs: new Map([['route', []]]),
+				symbols: { click: ['/build/root.js', 'value'] },
+			}),
+		).rejects.toThrow(/click.*delivery/);
+	});
+});
+
+function packedRegistry(context: object): PackedModuleRegistry {
+	return (context as Record<string, PackedModuleRegistry>)[PACKED_MODULE_REGISTRY_KEY]!;
+}
