+import { parseSync } from 'rolldown/experimental';
+import { describe, expect, test } from 'vitest';
+import {
+	createInlineResumerSource,
+	createInlineResumerSelfWakeSource,
+	createInlineResumerOverlayPrimerSource,
+	createPrerenderInlineResumerSource,
+	createPrerenderSettleInlineResumerSource,
+} from '../src/inline/resumer.ts';
+import { assemblePrerenderPageParts, renderToString } from '../src/render-to-string.ts';
+
+describe('packed delivery HTML', () => {
+	test('prerendered pages place the same ordered scripts in their head fragment', async () => {
+		const output = { html: '<button>Open</button>' };
+		const parts = await assemblePrerenderPageParts({ renderSsr: () => output }, output, {
+			scriptPacks: ['/runtime.js', '/route.js'],
+		});
+		expect(parts.head).toBe(
+			'<script src="/runtime.js"></script><script src="/route.js"></script>',
+		);
+		expect(parts.container).toContain('<button>Open</button>');
+	});
+
+	test('emits ordered classic scripts before the container and suppresses module preloads', async () => {
+		const html = await renderToString(
+			{
+				renderSsr: () => ({ html: '<button>Open</button>' }),
+				modulePreloads: ['/old-handler.js'],
+			},
+			{
+				scriptPacks: ['/runtime.js', '/route.js'],
+				nonce: 'nonce',
+			},
+		);
+		expect(html).toMatch(
+			/^<script src="\/runtime\.js" nonce="nonce"><\/script><script src="\/route\.js" nonce="nonce"><\/script><div/,
+		);
+		expect(html).not.toContain('modulepreload');
+		expect(html).toContain('<button>Open</button>');
+	});
+
+	for (const [name, source] of [
+		[
+			'event',
+			() =>
+				createInlineResumerSource({
+					debug: false,
+					executionLog: 'never',
+					graphSyncPolicy: false,
+					sharedGraphPolicy: false,
+					syncPolicy: false,
+					loading: 'registry',
+				}),
+		],
+		['self-wake', () => createInlineResumerSelfWakeSource('/resume.js', 'registry')],
+		['overlay', () => createInlineResumerOverlayPrimerSource('/resume.js', 'registry')],
+		[
+			'prerender',
+			() =>
+				createPrerenderInlineResumerSource(['click'], '/resume.js', {
+					loading: 'registry',
+				}),
+		],
+		[
+			'settle',
+			() => createPrerenderSettleInlineResumerSource(['click'], '/resume.js', 'registry'),
+		],
+	] as const) {
+		test(`${name} boot has no import expression`, () => {
+			const parsed = parseSync('boot.js', source(), { sourceType: 'script' });
+			expect(parsed.errors).toEqual([]);
+			expect(importExpressions(parsed.program)).toBe(0);
+		});
+	}
+});
+
+function importExpressions(value: unknown): number {
+	if (!value || typeof value !== 'object') return 0;
+	if (Array.isArray(value)) return value.reduce((sum, item) => sum + importExpressions(item), 0);
+	const node = value as Record<string, unknown>;
+	return (
+		(node.type === 'ImportExpression' ? 1 : 0) +
+		Object.values(node).reduce<number>((sum, item) => sum + importExpressions(item), 0)
+	);
+}
