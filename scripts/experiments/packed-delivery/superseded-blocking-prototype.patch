diff --git a/packages/bundler/src/build/pack-plan.ts b/packages/bundler/src/build/pack-plan.ts
new file mode 100644
index 00000000..782d6694
--- /dev/null
+++ b/packages/bundler/src/build/pack-plan.ts
@@ -0,0 +1,28 @@
+import type { MarklessBundleGraph } from '../types.ts';
+import { parseBundleGraph, planModulePreloads } from './preload-plan.ts';
+
+export function planModulePack(input: {
+	readonly graph: MarklessBundleGraph;
+	readonly roots: readonly string[];
+}): string[] {
+	for (const entry of input.graph) {
+		if (typeof entry !== 'number') continue;
+		if (
+			!Number.isFinite(entry) ||
+			(entry >= 0 && (!Number.isInteger(entry) || typeof input.graph[entry] !== 'string'))
+		) {
+			throw new Error(`Markless pack graph contains unresolved dependency index ${entry}.`);
+		}
+	}
+	const graph = parseBundleGraph(input.graph);
+	for (const root of input.roots) {
+		if (!graph.has(root))
+			throw new Error(`Markless pack root was not statically resolved: ${root}.`);
+	}
+	return planModulePreloads({
+		bundleGraph: input.graph,
+		roots: input.roots,
+		minProbability: 0,
+		maxPreloads: Number.POSITIVE_INFINITY,
+	}).map((module) => module.name);
+}
diff --git a/packages/bundler/src/build/packed-modules.ts b/packages/bundler/src/build/packed-modules.ts
new file mode 100644
index 00000000..2a1b6e71
--- /dev/null
+++ b/packages/bundler/src/build/packed-modules.ts
@@ -0,0 +1,174 @@
+import { dirname, join, normalize, relative } from 'pathe';
+import { rolldown } from 'rolldown';
+import { PACKED_MODULE_REGISTRY_KEY, packedSymbolKey, type PackedSymbolRoute } from '@markless/serializer/protocol';
+import { createPackedModuleRegistry } from './packed-registry.ts';
+
+const PACKED_ENTRY_PREFIX = '\0markless:packed-entry:';
+
+export type PackedModulesInput = {
+	readonly modules: ReadonlyMap<string, string>;
+	readonly packs: ReadonlyMap<string, readonly string[]>;
+	readonly symbols: Readonly<Record<string, PackedSymbolRoute>>;
+};
+
+export async function emitPackedModules(input: PackedModulesInput): Promise<{
+	readonly packs: ReadonlyMap<string, string>;
+}> {
+	const build = await rolldown({
+		input: [...input.modules.keys()].map((id) => PACKED_ENTRY_PREFIX + id),
+		preserveEntrySignatures: 'strict',
+		makeAbsoluteExternalsRelative: false,
+		treeshake: false,
+		plugins: [
+			{
+				name: 'markless-packed-modules',
+				resolveId(source, importer) {
+					if (source.startsWith(PACKED_ENTRY_PREFIX)) return source;
+					const id =
+						importer && source.startsWith('.')
+							? normalize(
+									join(
+										dirname(importer.slice(PACKED_ENTRY_PREFIX.length)),
+										source,
+									),
+								)
+							: source;
+					if (!input.modules.has(id)) {
+						this.error(
+							`Markless packed module ${importer ?? '<entry>'} depends on missing module ${source}.`,
+						);
+					}
+					return { id, external: 'absolute' };
+				},
+				load(entry) {
+					const id = entry.slice(PACKED_ENTRY_PREFIX.length);
+					const code = input.modules.get(id);
+					if (code === undefined) return null;
+					const replacements: { start: number; end: number; value: string }[] = [];
+					visitSyntax(this.parse(code), (node) => {
+						if (
+							![
+								'ImportExpression',
+								'ImportDeclaration',
+								'ExportNamedDeclaration',
+								'ExportAllDeclaration',
+							].includes(String(node.type))
+						)
+							return;
+						const source = node.source as
+							| { type?: string; value?: unknown; start: number; end: number }
+							| undefined;
+						if (!source && node.type === 'ExportNamedDeclaration') return;
+						if (source?.type !== 'Literal' || typeof source.value !== 'string') {
+							this.error(
+								`Markless packed module ${id} contains an import that cannot be statically resolved.`,
+							);
+						}
+						const dependency = source.value.startsWith('.')
+							? normalize(join(dirname(id), source.value))
+							: source.value;
+						if (!input.modules.has(dependency))
+							this.error(
+								`Markless packed module ${id} depends on missing module ${source.value}.`,
+							);
+						replacements.push({
+							start: source.start,
+							end: source.end,
+							value: JSON.stringify(dependency),
+						});
+					});
+					let rewritten = code;
+					for (const replacement of replacements.toSorted((a, b) => b.start - a.start)) {
+						rewritten =
+							rewritten.slice(0, replacement.start) +
+							replacement.value +
+							rewritten.slice(replacement.end);
+					}
+					return rewritten;
+				},
+			},
+		],
+	});
+	try {
+		const output = await build.generate({
+			format: 'cjs',
+			dynamicImportInCjs: false,
+			externalLiveBindings: true,
+			minify: false,
+			exports: 'named',
+			paths: (id) => id,
+		});
+		const chunks = output.output.filter((item) => item.type === 'chunk');
+		const idsByFile = new Map(
+			chunks.map((chunk) => [
+				chunk.fileName,
+				chunk.facadeModuleId?.startsWith(PACKED_ENTRY_PREFIX)
+					? chunk.facadeModuleId.slice(PACKED_ENTRY_PREFIX.length)
+					: PACKED_ENTRY_PREFIX + chunk.fileName,
+			]),
+		);
+		const support = chunks
+			.filter((chunk) => !chunk.facadeModuleId)
+			.map((chunk) => idsByFile.get(chunk.fileName)!);
+		const factories = new Map<string, string>();
+		const exportsById = new Map<string, readonly string[]>();
+		for (const chunk of chunks) {
+			exportsById.set(idsByFile.get(chunk.fileName)!, chunk.exports);
+			const aliases: Record<string, string> = {};
+			for (const dependency of chunk.imports) {
+				const target = idsByFile.get(dependency);
+				if (!target) continue;
+				const path = relative(dirname(chunk.fileName), dependency);
+				aliases[path.startsWith('.') ? path : `./${path}`] = target;
+			}
+			const requireSource =
+				Object.keys(aliases).length > 0
+					? `const imports=${JSON.stringify(aliases)};const require=id=>load(imports[id]??id);`
+					: 'const require=load;';
+			factories.set(
+				idsByFile.get(chunk.fileName)!,
+				`function(module,exports,load){${requireSource}\n${chunk.code}\n}`,
+			);
+		}
+		const delivered = new Set([...input.packs.values()].flat());
+		for (const [symbol, [id, name]] of Object.entries(input.symbols)) {
+			if (!delivered.has(id))
+				throw new Error(`Markless packed symbol ${symbol} has no delivery for ${id}.`);
+			if (!exportsById.get(id)?.includes(name))
+				throw new Error(
+					`Markless packed symbol ${symbol} references missing export ${name} in ${id}.`,
+				);
+		}
+		const packs = new Map<string, string>();
+		const key = JSON.stringify(PACKED_MODULE_REGISTRY_KEY);
+		for (const [name, ids] of input.packs) {
+			const entries = [...new Set([...support, ...ids])].map((id) => {
+				const factory = factories.get(id);
+				if (!factory) throw new Error(`Markless pack ${name} has no factory for ${id}.`);
+				return `${JSON.stringify(id)}:${factory}`;
+			});
+			const members = new Set(ids);
+			const symbols = Object.fromEntries(
+				Object.entries(input.symbols).filter(([, route]) => members.has(route[0])),
+			);
+			packs.set(
+				name,
+				`(()=>{const registry=globalThis[${key}]??=( ${createPackedModuleRegistry.toString()} )(${packedSymbolKey.toString()});registry.register({${entries.join(',\n')}},${JSON.stringify(symbols)});})();`,
+			);
+		}
+		return { packs };
+	} finally {
+		await build.close();
+	}
+}
+
+function visitSyntax(value: unknown, visit: (node: Record<string, unknown>) => void): void {
+	if (!value || typeof value !== 'object') return;
+	if (Array.isArray(value)) {
+		for (const child of value) visitSyntax(child, visit);
+		return;
+	}
+	const node = value as Record<string, unknown>;
+	if (typeof node.type === 'string') visit(node);
+	for (const child of Object.values(node)) visitSyntax(child, visit);
+}
diff --git a/packages/bundler/src/build/packed-registry.ts b/packages/bundler/src/build/packed-registry.ts
new file mode 100644
index 00000000..93054cd5
--- /dev/null
+++ b/packages/bundler/src/build/packed-registry.ts
@@ -0,0 +1,53 @@
+import type {
+	PackedModuleExports,
+	PackedModuleFactory,
+	PackedModuleRegistry,
+	PackedSymbolRoute,
+} from '@markless/serializer/protocol';
+
+export function createPackedModuleRegistry(symbolKey: (scope: string, id: string) => string): PackedModuleRegistry {
+	const factories = new Map<string, PackedModuleFactory>();
+	const symbols = new Map<string, PackedSymbolRoute>();
+	const modules = new Map<string, { exports: PackedModuleExports }>();
+	const failures = new Map<string, unknown>();
+	const load = (id: string): PackedModuleExports => {
+		if (failures.has(id)) throw failures.get(id);
+		const previous = modules.get(id);
+		if (previous) return previous.exports;
+		const factory = factories.get(id);
+		if (!factory) throw new Error(`Markless packed module is missing: ${id}`);
+		const module = { exports: {} };
+		modules.set(id, module);
+		try {
+			factory(module, module.exports, load);
+		} catch (error) {
+			failures.set(id, error);
+			throw error;
+		}
+		return module.exports;
+	};
+	return {
+		register(nextFactories, nextSymbols) {
+			for (const [id, factory] of Object.entries(nextFactories)) {
+				if (!factories.has(id)) factories.set(id, factory);
+			}
+			for (const [id, route] of Object.entries(nextSymbols)) {
+				const previous = symbols.get(id);
+				if (previous && (previous[0] !== route[0] || previous[1] !== route[1])) {
+					throw new Error(`Markless packed symbol has conflicting routes: ${id}`);
+				}
+				symbols.set(id, route);
+			}
+		},
+		load,
+		symbol(id, scope) {
+			const route = symbols.get(scope === undefined ? id : symbolKey(scope, id));
+			if (!route) throw new Error(`Markless packed symbol is missing: ${id}`);
+			const exports = load(route[0]);
+			if (!Object.hasOwn(exports, route[1])) {
+				throw new Error(`Markless packed symbol export is missing: ${id}`);
+			}
+			return exports[route[1]];
+		},
+	};
+}
