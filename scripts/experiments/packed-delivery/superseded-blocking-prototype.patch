+import { mkdtemp, mkdir, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'pathe';
+import { expect, test } from 'vitest';
+import { createClientAssetsManifest, readClientAssetsManifest, writeClientAssetsManifest } from '../../src/vite/client-assets-manifest.ts';
+import { createServerEntry } from '../../src/vite/runtime/create-server-entry.ts';
+
+test('persists ordered route pack URLs with the built client assets', async () => {
+	const directory = await mkdtemp(join(tmpdir(), 'markless-packed-assets-'));
+	try {
+		await mkdir(join(directory, 'build'));
+		for (const name of ['entry', 'runtime', 'route']) await writeFile(join(directory, 'build', `${name}.js`), '');
+		const manifest = createClientAssetsManifest({
+			base: '/', resumeEntry: '/build/entry.js', navigationEntry: '/build/entry.js',
+			routes: {
+				navigation: { 'pages/index.tsrx': [] }, ssr: { 'pages/index.tsrx': [] }, styles: { 'pages/index.tsrx': [] },
+				packs: { 'pages/index.tsrx': ['/build/runtime.js', '/build/route.js'] },
+			},
+		});
+		await writeClientAssetsManifest(directory, manifest);
+		expect((await readClientAssetsManifest(directory, '/')).routes.packs).toEqual({ 'pages/index.tsrx': ['/build/runtime.js', '/build/route.js'] });
+	} finally {
+		await rm(directory, { recursive: true, force: true });
+	}
+});
+
+test('the server places route packs in the head before a docs-style control', async () => {
+	const entry = createServerEntry({
+		documentModuleLoader: undefined,
+		pageModuleLoaders: { 'pages/index.tsrx': async () => ({ default: { renderSsr: () => ({ html: '<button>Open documentation menu</button>' }) } }) },
+		routeFileIds: ['/pages/index.tsrx'],
+		routeScriptPacks: { 'pages/index.tsrx': ['/build/runtime.js', '/build/route.js'] },
+	});
+	const html = await (await entry.fetch(new Request('https://docs.example/'))).text();
+	const head = html.slice(0, html.indexOf('</head>'));
+	const tags = '<script src="/build/runtime.js"></script><script src="/build/route.js"></script>';
+		expect(head).toContain(tags);
+		expect(html.indexOf(tags)).toBeLessThan(html.indexOf('<button>'));
+});
