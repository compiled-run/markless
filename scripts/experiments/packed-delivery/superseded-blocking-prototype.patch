+import { describe, expect, test } from 'vitest';
+import { PACKED_MODULE_REGISTRY_KEY } from '@markless/serializer/protocol';
+import { emitSymbolResolverModule } from '../src/passes/symbol-resolver-module.ts';
+
+describe('packed symbol resolver', () => {
+	test('binds captured arguments synchronously through the registered base handler', async () => {
+		const source = emitSymbolResolverModule({
+			loading: 'registry',
+			symbols: [{ id: 'base', chunk: '/base.js', exportName: 'activate' }],
+			boundSymbols: [
+				{
+					id: 'bound',
+					baseSymbolId: 'base',
+					componentEdgePath: ['edge:button'],
+					ancestry: [
+						{
+							componentEdgeId: 'edge:button',
+							branchScopeIds: [],
+							keyedRepeatScopeIds: [],
+						},
+					],
+					captureSlots: [
+						{
+							slotId: 'label',
+							path: [],
+							route: {
+								kind: 'compiler-known-constant',
+								componentEdgeId: 'edge:button',
+								value: 'Save',
+							},
+						},
+					],
+				},
+			],
+		});
+		const globals = globalThis as unknown as Record<string, unknown>;
+		const previous = globals[PACKED_MODULE_REGISTRY_KEY];
+		globals[PACKED_MODULE_REGISTRY_KEY] = {
+			symbol(id: string) {
+				expect(id).toBe('base');
+				return (context: { capture: { read(id: string): unknown } }) =>
+					context.capture.read('label');
+			},
+		};
+		try {
+			const resolver = await import(`data:text/javascript,${encodeURIComponent(source)}`);
+			const handler = resolver.loadSymbol('bound');
+			expect(typeof handler).toBe('function');
+			expect(handler({})).toBe('Save');
+		} finally {
+			if (previous === undefined) delete globals[PACKED_MODULE_REGISTRY_KEY];
+			else globals[PACKED_MODULE_REGISTRY_KEY] = previous;
+		}
+	});
+
+	test('returns a registered handler synchronously without initializing other symbols', async () => {
+		const source = emitSymbolResolverModule({
+			loading: 'registry',
+			symbols: [
+				{ id: 'increment', chunk: '/counter.js', exportName: 'increment' },
+				{ id: 'reset', chunk: '/reset.js', exportName: 'reset' },
+			],
+		});
+		const loaded: string[] = [];
+		const handler = () => 42;
+		const globals = globalThis as unknown as Record<string, unknown>;
+		const previous = globals[PACKED_MODULE_REGISTRY_KEY];
+		globals[PACKED_MODULE_REGISTRY_KEY] = {
+			symbol(id: string) {
+				loaded.push(id);
+				return handler;
+			},
+		};
+		try {
+			const resolver = await import(`data:text/javascript,${encodeURIComponent(source)}`);
+			expect(loaded).toEqual([]);
+			expect(resolver.loadSymbol('increment')).toBe(handler);
+			expect(loaded).toEqual(['increment']);
+		} finally {
+			if (previous === undefined) delete globals[PACKED_MODULE_REGISTRY_KEY];
+			else globals[PACKED_MODULE_REGISTRY_KEY] = previous;
+		}
+	});
+});
