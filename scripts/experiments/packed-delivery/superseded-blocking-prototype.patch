+import { expect, test } from 'vitest';
+import { marklessClient } from '../src/rolldown.ts';
+import { callGenerateBundle } from './helpers.ts';
+
+test('packed delivery receives finalized graph metadata and can emit pack assets', async () => {
+	const plugin = marklessClient();
+	let finalized = false;
+	plugin.api.registerPackedDelivery(({ bundle, metadata, emitAsset }) => {
+		finalized = true;
+		expect(bundle['build/entry.js']).toMatchObject({ code: 'export const value = 1;' });
+		expect(metadata.bundles['entry.js']).toBeDefined();
+		emitAsset('build/route.js', '(()=>{})();');
+	});
+	const assets: { fileName: string; source: string }[] = [];
+	await callGenerateBundle(plugin, {
+		'build/entry.js': { type: 'chunk', name: 'entry', fileName: 'build/entry.js', code: 'export const value = 1;', exports: ['value'], imports: [], dynamicImports: [], moduleIds: [] },
+	}, undefined, { emitFile(asset: { fileName: string; source: string }) { assets.push(asset); return asset.fileName; } });
+		expect(finalized).toBe(true);
+		expect(assets).toContainEqual({ type: 'asset', fileName: 'build/route.js', source: '(()=>{})();' });
+});
