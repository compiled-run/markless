@@ -0,0 +1,43 @@
+import { describe, expect, test } from 'vitest';
+import { planModulePack } from '../src/build/pack-plan.ts';
+
+describe('module pack membership', () => {
+	test('keeps static and dynamic dependencies regardless of probability', () => {
+		expect(
+			planModulePack({
+				graph: [
+					'click',
+					2,
+					'handler.js',
+					6,
+					-1,
+					7,
+					'shared.js',
+					'revealed.js',
+					-1,
+					10,
+					'nested.js',
+				],
+				roots: ['click'],
+			}),
+		).toEqual(['shared.js', 'handler.js', 'revealed.js', 'nested.js']);
+	});
+
+	test('rejects a root the build did not resolve', () => {
+		expect(() => planModulePack({ graph: ['other.js'], roots: ['missing.js'] })).toThrow(
+			/missing\.js/,
+		);
+	});
+
+	test('rejects malformed dependency indexes instead of silently omitting code', () => {
+		expect(() => planModulePack({ graph: ['handler.js', 9], roots: ['handler.js'] })).toThrow(
+			/dependency index 9/,
+		);
+	});
+
+	test('retains cyclic dependencies once and excludes unrelated route roots', () => {
+		expect(
+			planModulePack({ graph: ['a.js', 2, 'b.js', 0, 'other.js'], roots: ['a.js'] }),
+		).toEqual(['b.js', 'a.js']);
+	});
+});
