{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"plugins": [{ "name": "@markless/typescript-plugin" }],
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": ["node", "vitest"]
	},
	"exclude": ["dist", "node_modules", "poc", "packages/*/test", "packages/bundler/fixtures"],
	"include": [
		"packages/*/src/**/*.d.ts",
		"packages/*/src/**/*.ts",
		"packages/*/src/**/*.tsrx",
		"vite.config.ts"
	]
}
