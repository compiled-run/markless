{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"jsx": "preserve",
		"lib": [
			"ES2023",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"plugins": [
			{
				"name": "@markless/typescript-plugin"
			}
		],
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": [
			"node",
			"vitest"
		]
	},
	"exclude": [
		"dist",
		"node_modules",
		"poc",
		"packages/*/test",
		"packages/headless/*/test",
		"packages/bundler/fixtures",
		"packages/headless/*/test-support/vitest.config.ts",
		"packages/headless/*/test-support/playwright.config.ts"
	],
	"include": [
		"packages/*/src/**/*.d.ts",
		"packages/*/src/**/*.ts",
		"packages/*/src/**/*.tsrx",
		"packages/headless/*/src/**/*.d.ts",
		"packages/headless/*/src/**/*.ts",
		"packages/headless/*/src/**/*.tsrx",
		"packages/headless/*/test-support/**/*.ts",
		"vite.config.ts"
	],
	"tsrx": {
		"compiler": "@markless/typescript-plugin/volar"
	}
}
