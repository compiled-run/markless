	},
	"devDependencies": {
		"@markless/analyzer": "workspace:*",
		"@markless/typescript-plugin": "workspace:*",
		"@types/node": "24.12.2",
		"oxlint": "^1.79.0",
		"playwright-core": "^1.56.0",
		"shiki": "^4.4.3",
		"typescript": "^5.9.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
