{
	"name": "website",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "node --experimental-strip-types scripts/generate-seo.ts && vp build",
		"preview": "vp preview",
		"check": "vp check",
		"doctor": "node scripts/markless-doctor.mjs",
		"fmt": "vp fmt",
