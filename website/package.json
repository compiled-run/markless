{
	"name": "website",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"check": "vp check",
		"doctor": "node scripts/markless-doctor.mjs",
		"fmt": "vp fmt",
		"test": "vp test",
		"test:boxes": "witness run",
		"witness": "node --experimental-strip-types scripts/witness.ts",
		"route-types": "node scripts/write-route-types.ts",
		"typecheck": "pnpm run route-types && pnpm run typecheck:tsrx",
		"typecheck:tsrx": "node ../packages/typescript-plugin/src/tsc.ts -p tsconfig.json"
	},
	"dependencies": {
		"@markless/core": "workspace:*",
		"@markless/router": "workspace:*",
		"@markless/ui": "workspace:*",
		"destr": "^2.0.5",
		"nitro": "catalog:",
		"vite-plus": "1.3.0"
	},
	"devDependencies": {
		"@markless/analyzer": "workspace:*",
		"@markless/typescript-plugin": "workspace:*",
		"@markless/web": "workspace:*",
		"@tsrx/content-mapper": "0.1.2",
		"@tsrx/yuku": "0.8.0",
		"@types/node": "24.12.2",
		"oxlint": "^1.88.0",
		"playwright-core": "^1.64.1",
		"shiki": "^4.4.3",
		"typescript": "^5.9.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
	}
}
