{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "nitro",
	"installCommand": "cd .. && pnpm install --frozen-lockfile",
	"buildCommand": "NITRO_PRESET=vercel pnpm run build",
	"redirects": [
		{
			"source": "/start/first-app",
			"destination": "/start/walkthrough",
			"permanent": true
		}
	]
}
